# Discord Bot Token
# Получите токен на https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_token_here

# Ссылка на карту (опционально, если пусто — ссылка не показывается)
MAP_URL=

# Discord OAuth2 for authenticated reports from the map.
# Comma-separated callback URLs. Each must exactly match a URL registered in
# Discord Developer Portal. The API selects the callback matching the map domain.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URIS=https://dayz-map.ru/brodyaga-api/auth/callback,https://dayz-map.com/brodyaga-api/auth/callback

# Public URL of the map. The API accepts OAuth redirects only back to this origin.
MAP_PUBLIC_URL=https://dayz-map.ru
# Comma-separated map origins allowed as OAuth return destinations.
MAP_ALLOWED_ORIGINS=https://dayz-map.ru,https://dayz-map.com
# A long random value used to protect browser sessions; do not commit the real value.
BRODYAGA_SESSION_SECRET=replace_with_a_long_random_secret
# Keep 127.0.0.1 if the map proxy and bot share a server. For separate servers,
# use 0.0.0.0 and allow port 8099 only from the map server firewall address.
BRODYAGA_API_BIND_ADDRESS=127.0.0.1
# Optional when the public map and API are different subdomains, for example
# dayz-map.ru and origin.dayz-map.ru. Leave empty for a same-origin deployment.
BRODYAGA_SESSION_COOKIE_DOMAIN=
# Comma-separated origins allowed to use the browser API.
BRODYAGA_CORS_ORIGIN=https://dayz-map.ru,https://dayz-map.com

# Realtime delivery to the map. Configure the same random secret (32+ characters)
# in profiles_backend/.env on the map server. Redis stays private.
# For development use the development map URL and a different secret.
BRODYAGA_PUSH_URL=https://dayz-map.ru/profiles-api/internal/brodyaga/reports
BRODYAGA_PUSH_SECRET=
# Optional JSON array for independent delivery to multiple environments.
# When set, replaces BRODYAGA_PUSH_URL/BRODYAGA_PUSH_SECRET. Keep actual keys private.
# BRODYAGA_PUSH_TARGETS=[{"url":"https://dayz-map.ru/profiles-api/internal/brodyaga/reports","secret":"REPLACE_WITH_PROD_SECRET_32_CHARS_MIN"},{"url":"https://dev.dayz-map.ru/profiles-api/internal/brodyaga/reports","secret":"REPLACE_WITH_DEV_SECRET_32_CHARS_MIN"}]
